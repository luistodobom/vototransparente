---
import "../styles/global.css";
import { url } from "../lib/format";

interface Props {
  title?: string;
  description?: string;
  active?: string;
  noindex?: boolean;
}
const { title, description = "Todas as votações da Assembleia da República, explicadas de forma clara: o que foi proposto, quem votou a favor e contra, e o que muda.", active = "", noindex = false } = Astro.props;
const fullTitle = title ? `${title} · VotoTransparente` : "VotoTransparente — As votações do Parlamento, explicadas";
const nav = [
  { href: "/parlamento/votacoes/", label: "Votações", key: "votacoes" },
  { href: "/parlamento/deputados/", label: "Deputados", key: "deputados" },
  { href: "/parlamento/partidos/", label: "Partidos", key: "partidos" },
  { href: "/sobre/", label: "Sobre", key: "sobre" },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_PT" />
  <meta name="theme-color" content="#0f5c4d" />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
  <script is:inline>
    try { const t = localStorage.getItem("vt-theme"); if (t) document.documentElement.dataset.theme = t; } catch {}
  </script>
</head>
<body>
  <a href="#main" class="skip">Saltar para o conteúdo</a>
  <header class="site-header">
    <div class="container bar">
      <a class="brand" href={url("/")} aria-label="VotoTransparente — início">
        <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
          <rect width="32" height="32" rx="9" fill="var(--accent)" />
          <path d="M6 22a10 10 0 0 1 20 0" fill="none" stroke="var(--accent-ink)" stroke-width="2.4" stroke-linecap="round" />
          <circle cx="11" cy="18.5" r="1.8" fill="var(--accent-ink)" /><circle cx="16" cy="16.3" r="1.8" fill="var(--accent-ink)" /><circle cx="21" cy="18.5" r="1.8" fill="var(--accent-ink)" />
        </svg>
        <span>Voto<b>Transparente</b></span>
      </a>
      <nav class="nav" aria-label="Principal">
        {nav.map((n) => (
          <a href={url(n.href)} aria-current={active === n.key ? "page" : undefined}>{n.label}</a>
        ))}
      </nav>
      <div class="tools">
        <a class="icon-btn" href={url("/parlamento/votacoes/")} aria-label="Pesquisar votações" title="Pesquisar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </a>
        <button class="icon-btn" id="theme-toggle" aria-label="Alternar tema claro/escuro" title="Tema">
          <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </div>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container foot">
      <div>
        <div class="brand small-brand">Voto<b>Transparente</b></div>
        <p class="muted small">Um projeto independente de transparência. Dados oficiais da Assembleia da República; resumos gerados por IA e revistos por amostragem — podem conter erros.</p>
      </div>
      <div class="foot-links small">
        <a href={url("/parlamento/votacoes/")}>Votações</a>
        <a href={url("/parlamento/deputados/")}>Deputados</a>
        <a href={url("/parlamento/partidos/")}>Partidos</a>
        <a href={url("/sobre/")}>Metodologia</a>
        <a href="https://github.com/luistodobom/vototransparente" rel="noopener">GitHub</a>
        <a href="https://github.com/luistodobom/vototransparente/issues" rel="noopener">Reportar um erro</a>
      </div>
    </div>
  </footer>
  <script>
    const btn = document.getElementById("theme-toggle");
    btn?.addEventListener("click", () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      root.dataset.theme = dark ? "light" : "dark";
      try { localStorage.setItem("vt-theme", root.dataset.theme); } catch {}
    });
  </script>
</body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--bg-elev); padding: 8px 12px; border-radius: 8px; z-index: 100; }
  .skip:focus { left: 8px; }
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 20px; height: 62px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-size: 1.08rem; letter-spacing: -0.01em; font-weight: 500; }
  .brand b { font-weight: 750; }
  .nav { display: flex; gap: 4px; margin-left: 8px; }
  .nav a { text-decoration: none; padding: 7px 12px; border-radius: 999px; font-weight: 550; font-size: 0.93rem; color: var(--ink-2); }
  .nav a:hover { background: var(--bg-sunken); color: var(--ink); }
  .nav a[aria-current="page"] { background: var(--ink); color: var(--bg); }
  .tools { margin-left: auto; display: flex; gap: 6px; }
  .icon-btn { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--line); background: var(--bg-elev); cursor: pointer; color: var(--ink-2); }
  .icon-btn:hover { color: var(--ink); border-color: var(--line-strong); }
  .moon { display: none; }
  :global(:root[data-theme="dark"]) .sun { display: none; }
  :global(:root[data-theme="dark"]) .moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sun { display: none; }
    :global(:root:not([data-theme="light"])) .moon { display: block; }
  }
  @media (max-width: 640px) {
    .bar { flex-wrap: wrap; height: auto; padding-block: 10px; gap: 8px 12px; }
    .brand span { font-size: 1rem; }
    .nav { order: 3; width: 100%; margin: 0 -4px; overflow-x: auto; }
  }
  .site-footer { border-top: 1px solid var(--line); margin-top: 64px; padding-block: 36px 48px; background: var(--bg-sunken); }
  .foot { display: grid; gap: 24px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .foot { grid-template-columns: 1.4fr 1fr; } }
  .foot p { max-width: 52ch; margin-top: 8px; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 10px 20px; align-content: start; justify-content: flex-start; }
  @media (min-width: 720px) { .foot-links { justify-content: flex-end; } }
  .foot-links a { text-decoration: none; color: var(--ink-2); }
  .foot-links a:hover { color: var(--ink); }
  .small-brand { font-size: 1rem; }
</style>
