---
import { STATUS_LABEL } from "../lib/format";
interface Props { status: string }
const { status } = Astro.props;
const cls = status === "aprovado" ? "ok" : status === "rejeitado" ? "no" : status === "em_curso" ? "mid" : "neutral";
---
<span class={`badge ${cls}`}>{STATUS_LABEL[status] ?? status}</span>
